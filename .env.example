# Sage (سايج) — Environment Configuration Template
# Copy this to .env for local development

NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000/api

# Database (PostgreSQL 16 / Neon Serverless)
# In local Docker: postgresql://sage_user:sage_password@localhost:5432/sage_db
# In production (Neon): pooled connection string e.g. postgresql://user:pass@ep-xyz-pooler.neon.tech/sage_db?sslmode=require
DATABASE_URL=postgresql://sage_user:sage_password@localhost:5432/sage_db
DATABASE_POOL_MAX=10

# Redis Cache & Rate-Limiting
# Provider: 'local' (Docker Redis 7 via TCP) or 'upstash' (Serverless REST/TLS)
REDIS_PROVIDER=local
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Object Storage (SeaweedFS S3 locally / Backblaze B2 in production)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=sage_s3_admin
S3_SECRET_ACCESS_KEY=sage_s3_secret_key
S3_BUCKET_NAME=sage-media
S3_FORCE_PATH_STYLE=true

# Authentication Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_in_production_32chars_long
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_32chars_long
JWT_PLAYBACK_SECRET=dev_jwt_playback_secret_change_in_production_32chars_long

# Email (Mailpit locally / Brevo SMTP in production)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sage <noreply@sage.local>

# Real-time Provider ('sse' or 'pusher')
REALTIME_PROVIDER=sse
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Transcoding Profile ('local' worker in Docker or 'cloud' via GitHub Actions dispatch)
TRANSCODE_PROFILE=local
